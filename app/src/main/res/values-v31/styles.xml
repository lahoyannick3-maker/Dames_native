<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DamesGameplay" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_fond</item>

        <!-- Android 12+ affiche toujours un splash système avant que
             l'activité ne se dessine (icône ronde sur un fond). On ne peut
             pas le supprimer, mais on peut le rendre invisible en tant que
             tel : même fond que SplashView.kt, et une icône transparente
             (pas de robot Android par défaut). Résultat : un seul écran de
             démarrage perçu, celui avec "DAME GAME PLAY". -->
        <item name="android:windowSplashScreenBackground">@color/splash_fond</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/icone_splash_transparente</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_fond</item>
        <item name="android:windowSplashScreenBrandingImage">@null</item>
    </style>
</resources>
