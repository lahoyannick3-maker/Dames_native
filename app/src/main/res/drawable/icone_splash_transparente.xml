<?xml version="1.0" encoding="utf-8"?>
<!-- Icône réellement invisible (opacité 0), mais avec un <path> valide et
     une taille standard (240dp, taille recommandée par Android pour
     windowSplashScreenAnimatedIcon). La version précédente (vecteur sans
     aucun <path>) était semble-t-il rejetée au runtime, ce qui faisait
     retomber Android sur l'icône par défaut (le robot bleu). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="240"
    android:viewportHeight="240">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h240v240h-240z" />
</vector>
